<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.pointapi.mapper.UserMapper">
    <select id="getUser" parameterType="Long"  resultType="com.example.pointapi.model.UserMstDto">
        select
        user_no
        , user_id
        , user_name
        from dms.user_mst
        where user_no = #{userNo}
    </select>
</mapper>